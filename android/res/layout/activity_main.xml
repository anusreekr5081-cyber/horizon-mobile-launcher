<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_dark"
    android:padding="16dp">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/accent_green" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Horizon 26.3 (Pure Rust)"
            android:textSize="12sp"
            android:textColor="@color/text_secondary"
            android:background="@drawable/button_secondary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp" />
    </LinearLayout>

    <!-- Main Dashboard Split Layout -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- Left Column: Profile & Engine Config -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="14dp"
            android:layout_marginEnd="8dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PLAYER PROFILE"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/accent_blue"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/edit_player_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Enter Player Name"
                android:text="Player"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_muted"
                android:background="@drawable/button_secondary"
                android:padding="10dp"
                android:textSize="14sp"
                android:layout_marginBottom="10dp"
                android:inputType="textPersonName" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RENDERER BACKEND"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/accent_blue"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinner_renderer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_secondary"
                android:padding="8dp"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/txt_ram_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ALLOCATED RAM: 1024 MiB (Balanced)"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/accent_blue"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seek_ram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="3840"
                android:progress="768"
                android:layout_marginBottom="8dp" />

            <!-- Preset Buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btn_preset_ultralow"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="512M"
                    android:textSize="10sp"
                    android:background="@drawable/button_secondary"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_balanced"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="1024M"
                    android:textSize="10sp"
                    android:background="@drawable/button_secondary"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_high"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="2048M"
                    android:textSize="10sp"
                    android:background="@drawable/button_secondary"
                    android:textColor="@color/text_secondary"
                    android:layout_marginEnd="4dp" />

                <Button
                    android:id="@+id/btn_preset_extreme"
                    android:layout_width="0dp"
                    android:layout_height="36dp"
                    android:layout_weight="1"
                    android:text="240Hz"
                    android:textSize="10sp"
                    android:background="@drawable/button_secondary"
                    android:textColor="@color/accent_amber" />
            </LinearLayout>
        </LinearLayout>

        <!-- Right Column: Video & Controls & Play Button -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:background="@drawable/card_background"
            android:padding="14dp"
            android:layout_marginStart="8dp">

            <TextView
                android:id="@+id/txt_scale_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="RENDER SCALE: 75% (Low-End Friendly)"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/accent_blue"
                android:layout_marginBottom="4dp" />

            <SeekBar
                android:id="@+id/seek_scale"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="50"
                android:progress="25"
                android:layout_marginBottom="12dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="VIRTUAL CONTROLS"
                android:textStyle="bold"
                android:textSize="12sp"
                android:textColor="@color/accent_blue"
                android:layout_marginBottom="6dp" />

            <Spinner
                android:id="@+id/spinner_controls"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/button_secondary"
                android:padding="8dp"
                android:layout_marginBottom="16dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Big Launch Button -->
            <Button
                android:id="@+id/btn_launch"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="@string/btn_play"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:background="@drawable/button_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
