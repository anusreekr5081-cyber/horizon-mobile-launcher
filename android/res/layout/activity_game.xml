<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Native Game Surface -->
    <SurfaceView
        android:id="@+id/surface_game"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- In-Game Touchpad and Virtual Gamepad Overlay -->
    <dev.horizonmobile.launcher.TouchpadOverlayView
        android:id="@+id/touch_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Virtual Mouse Cursor (follows trackpad in mouse mode) -->
    <ImageView
        android:id="@+id/img_cursor"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/ic_launcher"
        android:visibility="gone" />
</FrameLayout>
